    {
      "name": "1- Create Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "//Fecth the token from response\n// const response = pm.response.json();\n// const tokenID = response.token;\n// console.log(\"Token is ==> \"+tokenID);\n\n// pm.variables.set('token_id',tokenID);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
